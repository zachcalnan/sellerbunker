#
# Personal VPS env for Seller Bunker (one account, always-on).
# Copy to deploy/.env.personal and fill from your current Render dashboard.
#   cp deploy/.env.personal.example deploy/.env.personal
#
# Do NOT commit .env.personal.
#

# --- Host / URLs (keep phone bookmark working) ---
# Comma-separated hostnames Caddy will serve (Let's Encrypt). Keep the same URL as your phone bookmark.
SITE_ADDRESS="www.sellerbunker.com, sellerbunker.com"
FRONTEND_URL=https://www.sellerbunker.com
NEXT_PUBLIC_API_URL=https://www.sellerbunker.com
NEXT_PUBLIC_APP_URL=https://www.sellerbunker.com
CORS_ORIGINS=https://www.sellerbunker.com,https://sellerbunker.com

# --- Postgres (compose injects DATABASE_URL; set a strong password) ---
POSTGRES_USER=seller
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=sellertoolkit

# --- App core ---
JWT_SECRET=change-me-long-random
BYPASS_BILLING=true
NEXT_PUBLIC_BYPASS_BILLING=true
ENABLE_AMAZON_SYNC_SCHEDULER=true
ENABLE_REPRICER_SCHEDULER=true
# REPRICER_DRY_RUN=true
# REPRICER_PASSWORD=repricer

# --- Clerk (same keys as production Render / Clerk dashboard) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
# CLERK_WEBHOOK_SECRET=whsec_replace_me
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# --- Amazon SP-API / LWA (app credentials; seller tokens live in the DB dump) ---
AMAZON_APP_ID=amzn1.sellerapps.app.replace-me
AMAZON_REDIRECT_URI=https://www.sellerbunker.com/api/amazon/oauth/callback
LWA_CLIENT_ID=amzn1.application-oa2-client.replace-me
LWA_CLIENT_SECRET=replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/replace-me
SPAPI_USE_SANDBOX=false
SPAPI_DEBUG_LOGS=false

# --- Optional: Stripe / email (not required with BYPASS_BILLING=true) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_BASIC_PLAN_PRODUCT_ID=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
