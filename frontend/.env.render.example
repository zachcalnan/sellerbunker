#
# Render test frontend environment
# Required now: needed for the Next.js app to talk to the test backend.
# Optional later: only needed when enabling that integration in test.
#

# Required now
NEXT_PUBLIC_API_URL=https://seller-bunker-test-backend.onrender.com
NEXT_PUBLIC_APP_URL=https://seller-bunker-test-frontend.onrender.com
NEXT_PUBLIC_BYPASS_BILLING=true

# Required now if Clerk-backed sign-in is enabled for the test stack
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Optional later: Stripe checkout from frontend server routes
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_BASIC_PLAN_PRODUCT_ID=prod_replace_me

# Optional later: Clerk webhook route on the frontend
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
# CLERK_WEBHOOK_SECRET=replace-me

# Optional later: contact form email
# RESEND_API_KEY=re_replace_me
# RESEND_FROM_EMAIL=SellerBunker Contact <support@example.com>
