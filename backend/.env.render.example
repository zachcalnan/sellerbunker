#
# Render test backend environment
# Required now: needed for the backend to boot in an isolated test stack.
# Optional later: only needed when enabling that integration in test.
#

# Required now
DATABASE_URL=postgresql://user:password@host:5432/seller_dashboard_test?schema=public
# Optional: cap Prisma pool size per process (helps when Render Postgres has a low max_connections and you run multiple workers).
# PRISMA_CONNECTION_LIMIT=5
# If DATABASE_URL omits pool_timeout / connect_timeout, the app merges pool_timeout=30 and connect_timeout=20.
# BullMQ (repricer + other queues). Local docker-compose Redis defaults to redis://localhost:6379 if unset.
REDIS_URL=redis://red-xxxxxxxxxxxxxxxxxxxx:6379
# Repricer tick schedule is on by default; set to false only if you must disable it.
# ENABLE_REPRICER_SCHEDULER=false
FRONTEND_URL=https://seller-bunker-test-frontend.onrender.com
JWT_SECRET=replace-me
ENABLE_AMAZON_SYNC_SCHEDULER=false
BYPASS_BILLING=true

# Required now if Clerk-backed sign-in is enabled for the test stack
CLERK_SECRET_KEY=sk_test_replace_me

# Optional now, recommended only if you need extra browser origins
# CORS_ORIGINS=https://seller-bunker-test-frontend.onrender.com

# Optional later: Stripe (webhook must include invoice.paid for subscription commissions)
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: slow Finances per-order calls to reduce Amazon 429 QuotaExceeded (default 2200ms in code).
# AMAZON_ORDER_FINANCES_PAUSE_MS=3000
# Optional: disable boot-time allowlist fee backfill if it stacks with sync and starves Finances quota.
# AMAZON_ORDER_LINE_FEE_BACKFILL_BOOTSTRAP=false

# Optional: affiliate admin API (header x-affiliate-admin-secret) and commission rules
# AFFILIATE_ADMIN_SECRET=long-random-string
# AFFILIATE_MIN_PAID_INVOICE_NUMBER=1
# Tiered share of each qualifying payment per referred user (defaults: 1 = 100%, 0.5 = 50%, 0.25 = 25%)
# AFFILIATE_COMMISSION_RATE_PAYMENT_1=1
# AFFILIATE_COMMISSION_RATE_PAYMENT_2=0.5
# AFFILIATE_COMMISSION_RATE_PAYMENT_3_PLUS=0.25

# Brevo: Clerk sign-ups + auto backfill to list "SellerBunker Users" (use that list's numeric ID)
# BREVO_API_KEY=xkeysib-...
# BREVO_SIGNUP_LIST_ID=2
# SENDER_EMAIL=hello@yourdomain.com
# SENDER_NAME=SellerBunker
# ENABLE_BREVO_CONTACT_SYNC_SCHEDULER=true
# BREVO_CONTACT_SYNC_EVERY_MS=21600000
# BREVO_SYNC_BATCH_LIMIT=200
# EMAIL_ADMIN_SECRET=long-random-string

# Optional later: Clerk deletion webhook relay
# CLERK_WEBHOOK_SECRET=replace-me

# Optional later: Amazon OAuth / SP-API
# AMAZON_APP_ID=amzn1.sellerapps.app.replace-me
# AMAZON_REDIRECT_URI=https://seller-bunker-test-backend.onrender.com/api/amazon/oauth/callback
# LWA_CLIENT_ID=amzn1.application-oa2-client.replace-me
# LWA_CLIENT_SECRET=replace-me
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/replace-me
# SPAPI_USE_SANDBOX=false
# SPAPI_DEBUG_LOGS=false

# Optional: Amazon sync schedules (tiered — frequent only where it matters)
# AMAZON_ORDERS_HOT_SYNC_EVERY_MS=300000          # 5 min — recent orders (last ~3 days)
# AMAZON_ORDERS_FULL_SYNC_CRON=0 2 * * *          # nightly full 30d orders + finances
# AMAZON_INVENTORY_SYNC_CRON=0 3 * * *            # nightly FBA inventory
# AMAZON_SHIPMENTS_SYNC_CRON=0 4 * * *            # nightly inbound shipments
# AMAZON_TITLES_BACKFILL_CRON=0 5 * * *           # nightly product titles/images
# FEE_ESTIMATE_REFRESH_CRON=0 6 * * *             # daily Product Fees API
# LISTING_PRICE_REFRESH_HOT_EVERY_MS=1800000      # 30 min — in-stock / recently sold list prices
# LISTING_PRICE_REFRESH_COLD_CRON=0 7 * * *       # nightly — other SKUs
# LISTING_PRICE_REFRESH_DELAY_MS=300
# LISTING_PRICE_HOT_RECENTLY_SOLD_WITHIN_HOURS=72
# FEE_ESTIMATE_DELAY_MS=1000
# FEE_SYNC_JOB_LOCK_DURATION_MS=14400000
# AMAZON_TITLES_BACKFILL_LIMIT=100

# Repricer module (password protected testing)
# REPRICER_PASSWORD=repricer
# Repricer PATCHes Amazon listing prices by default. Set REPRICER_DRY_RUN=true only for simulation-only (no Amazon writes).
# REPRICER_DRY_RUN=true
# When DRY_RUN is on: by default we do NOT update currentListedPrice in the DB (so SB matches Seller Central). Set true only for local testing.
# REPRICER_SIMULATE_PRICE_UPDATE=true

# Optional platform/runtime overrides
# PORT=10000
# JWT_EXPIRES_IN=7d
