// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User/Seller model
model User {
  id            String   @id @default(uuid())
  clerkId       String?  @unique
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String?
  activeOrgId   String?  @map("active_org_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  activeOrg Organization? @relation("ActiveOrg", fields: [activeOrgId], references: [id])
  orgMemberships OrganizationMembership[]

  sellerAccounts SellerAccount[]
  products       Product[]
  orders         Order[]
  orderItems     OrderItem[]
  inventory      Inventory[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members   OrganizationMembership[]
  usersWithActiveOrg User[] @relation("ActiveOrg")

  @@map("organizations")
}

model OrganizationMembership {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  userId    String   @map("user_id")
  role      String   @default("member") // "owner" | "member"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
  @@map("organization_memberships")
}

// Seller accounts connected to marketplaces (Amazon, eBay, etc.)
model SellerAccount {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  marketplace        String   // 'amazon' | 'ebay' | 'walmart' | 'etsy'
  sellerId           String?  @map("seller_id") // Marketplace seller ID
  credentials        Json     // Encrypted tokens, refresh tokens, etc.
  isActive           Boolean  @default(true) @map("is_active")
  ordersLastSyncedAt DateTime? @map("orders_last_synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketplace])
  @@map("seller_accounts")
  @@index([userId])
}

// Products/SKUs
model Product {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  sku         String
  asin        String?  // Amazon ASIN
  title       String?
  imageUrl    String?  @map("image_url")
  costOfGoods Decimal? @map("cost_of_goods") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders   Order[]
  orderItems OrderItem[]
  inventory Inventory?

  @@unique([userId, sku])
  @@index([userId])
  @@index([asin])
  @@map("products")
}

// Orders from marketplaces
model Order {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  productId       String   @map("product_id")
  orderId         String   @map("order_id") // Marketplace order ID
  marketplace     String   // 'amazon' | 'ebay' | etc.
  sku             String
  asin            String?
  quantity        Int      @default(1)
  itemPrice       Decimal  @map("item_price") @db.Decimal(10, 2)
  fees            Json     // FBA fees, referral fees, etc.
  totalProfit     Decimal? @map("total_profit") @db.Decimal(10, 2)
  rawResponse     Json?    @map("raw_response") // Full API response
  orderDate       DateTime @map("order_date")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([orderId, marketplace])
  @@index([userId])
  @@index([userId, orderDate])
  @@index([productId])
  @@map("orders")
}

// Order items (line items) for accurate per-product analytics
model OrderItem {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  orderDbId   String   @map("order_db_id")
  productId   String   @map("product_id")

  // Marketplace identifiers
  marketplace String   // 'amazon' | 'ebay' | etc.
  orderId     String   @map("order_id") // Marketplace order ID (e.g. AmazonOrderId)
  orderItemId String   @map("order_item_id") // Marketplace order item ID

  sku         String
  asin        String?

  quantity    Int      @default(1)

  // Amounts are totals for this line item (not per-unit)
  revenueTotal        Decimal  @map("revenue_total") @db.Decimal(14, 2)
  shippingChargedTotal Decimal @map("shipping_charged_total") @db.Decimal(14, 2)
  taxChargedTotal     Decimal  @map("tax_charged_total") @db.Decimal(14, 2)
  amazonFeesTotal     Decimal  @map("amazon_fees_total") @db.Decimal(14, 2)

  // Nullable until the seller provides COGS; when null, profit is unknown.
  cogsTotal  Decimal? @map("cogs_total") @db.Decimal(14, 2)
  profit     Decimal? @map("profit") @db.Decimal(14, 2)

  rawResponse Json?   @map("raw_response")
  orderDate   DateTime @map("order_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderDbId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orderDbId, orderItemId])
  @@index([userId])
  @@index([userId, orderDate])
  @@index([productId])
  @@map("order_items")
}

// Inventory levels
model Inventory {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  productId  String   @unique @map("product_id")
  currentQty Int      @default(0) @map("current_qty")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("inventory")
}

// Daily KPI aggregates for fast dashboard reads
model AggDailyKpiSummary {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  marketplace        String
  fulfilmentChannel  String   @map("fulfilment_channel")
  date               DateTime @map("date")

  revenue            Decimal  @db.Decimal(14, 2)
  unitsSold          Int
  ordersCount        Int      @map("orders_count")
  amazonFeesTotal    Decimal  @map("amazon_fees_total") @db.Decimal(14, 2)
  refundsTotal       Decimal  @map("refunds_total") @db.Decimal(14, 2)
  cogsTotal          Decimal  @map("cogs_total") @db.Decimal(14, 2)
  prepFeesTotal      Decimal  @map("prep_fees_total") @db.Decimal(14, 2)
  shippingCostsTotal Decimal  @map("shipping_costs_total") @db.Decimal(14, 2)
  advertisingTotal   Decimal  @map("advertising_total") @db.Decimal(14, 2)
  vatOnAmazonFeesTotal Decimal @map("vat_on_amazon_fees_total") @db.Decimal(14, 2)
  vatEstimateTotal   Decimal  @map("vat_estimate_total") @db.Decimal(14, 2)
  softwareSubsTotal  Decimal  @map("software_subs_total") @db.Decimal(14, 2)
  otherSubsTotal     Decimal  @map("other_subs_total") @db.Decimal(14, 2)
  vatTotal           Decimal  @map("vat_total") @db.Decimal(14, 2)
  otherCostsTotal    Decimal  @map("other_costs_total") @db.Decimal(14, 2)
  profit             Decimal  @db.Decimal(14, 2)
  roiPct             Decimal  @map("roi_pct") @db.Decimal(7, 4)
  marginPct          Decimal  @map("margin_pct") @db.Decimal(7, 4)

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([userId, marketplace, fulfilmentChannel, date])
  @@index([userId])
  @@map("agg_daily_kpi_summary")
}
