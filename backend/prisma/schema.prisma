generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                   @id @default(uuid())
  email          String                   @unique
  passwordHash   String                   @map("password_hash")
  name           String?
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  clerkId        String?                  @unique
  activeOrgId    String?                  @map("active_org_id")
  inventoryByMarketplace InventoryByMarketplace[]
  inventory      Inventory[]
  orderItems     OrderItem[]
  orders         Order[]
  orgMemberships OrganizationMembership[]
  products       Product[]
  purchases      Purchase[]
  sellerAccounts SellerAccount[]
  activeOrg      Organization?            @relation("ActiveOrg", fields: [activeOrgId], references: [id])

  @@map("users")
}

model Organization {
  id                     String                   @id @default(uuid())
  name                   String
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  lastFbaInventorySyncAt DateTime?
  lastFeesEstimateAt     DateTime?                @map("last_fees_estimate_at")
  members                OrganizationMembership[]
  usersWithActiveOrg     User[]                   @relation("ActiveOrg")

  @@map("organizations")
}

model OrganizationMembership {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  userId    String       @map("user_id")
  role      String       @default("member")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
  @@map("organization_memberships")
}

model SellerAccount {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  marketplace        String
  sellerId           String?   @map("seller_id")
  credentials        Json
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  ordersLastSyncedAt DateTime? @map("orders_last_synced_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketplace])
  @@index([userId])
  @@map("seller_accounts")
}

model Product {
  id                         String      @id @default(uuid())
  userId                     String      @map("user_id")
  sku                        String
  asin                       String?
  title                      String?
  imageUrl                   String?     @map("image_url")
  costOfGoods                Decimal?    @map("cost_of_goods") @db.Decimal(10, 2)
  estimatedAmazonFeePerUnit  Decimal?    @map("estimated_amazon_fee_per_unit") @db.Decimal(10, 2)
  estimatedReferralFeePerUnit Decimal?   @map("estimated_referral_fee_per_unit") @db.Decimal(10, 2)
  estimatedFbaFeePerUnit     Decimal?    @map("estimated_fba_fee_per_unit") @db.Decimal(10, 2)
  estimatedAmazonFeeUpdatedAt DateTime?  @map("estimated_amazon_fee_updated_at")
  currentListedPrice         Decimal?    @map("current_listed_price") @db.Decimal(10, 2)
  feeEstimateRawJson         Json?       @map("fee_estimate_raw_json")
  createdAt                  DateTime    @default(now()) @map("created_at")
  updatedAt                  DateTime    @updatedAt @map("updated_at")
  inventory   Inventory?
  inventoryByMarketplace InventoryByMarketplace[]
  orderItems  OrderItem[]
  orders      Order[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases   Purchase[]

  @@unique([userId, sku])
  @@index([userId])
  @@index([asin])
  @@map("products")
}

model Order {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  productId   String      @map("product_id")
  orderId     String      @map("order_id")
  marketplace String
  sku         String
  asin        String?
  quantity    Int         @default(1)
  itemPrice   Decimal     @map("item_price") @db.Decimal(10, 2)
  fees        Json
  totalProfit Decimal?    @map("total_profit") @db.Decimal(10, 2)
  rawResponse Json?       @map("raw_response")
  orderDate   DateTime    @map("order_date")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  orderItems  OrderItem[]
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orderId, marketplace])
  @@index([userId])
  @@index([userId, orderDate])
  @@index([productId])
  @@map("orders")
}

model OrderItem {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  orderDbId            String   @map("order_db_id")
  productId            String   @map("product_id")
  marketplace          String
  orderId              String   @map("order_id")
  orderItemId          String   @map("order_item_id")
  sku                  String
  asin                 String?
  quantity             Int      @default(1)
  revenueTotal         Decimal  @map("revenue_total") @db.Decimal(14, 2)
  shippingChargedTotal Decimal  @map("shipping_charged_total") @db.Decimal(14, 2)
  taxChargedTotal      Decimal  @map("tax_charged_total") @db.Decimal(14, 2)
  amazonFeesTotal      Decimal  @map("amazon_fees_total") @db.Decimal(14, 2)
  feesSource           String?  @map("fees_source") // 'finances' = settled from Finances API (exact); 'estimate' = from product estimate
  cogsTotal            Decimal? @map("cogs_total") @db.Decimal(14, 2)
  profit               Decimal? @map("profit") @db.Decimal(14, 2)
  rawResponse          Json?    @map("raw_response")
  orderDate            DateTime @map("order_date")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  order                Order    @relation(fields: [orderDbId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderDbId, orderItemId])
  @@index([userId])
  @@index([userId, orderDate])
  @@index([productId])
  @@map("order_items")
}

model Inventory {
  productId String @id @map("product_id")
  userId    String @map("user_id")

  // Summary buckets (table view)
  availableQty Int @default(0) @map("available_qty") // = fulfillable
  reservedQty  Int @default(0) @map("reserved_qty")
  inboundQty   Int @default(0) @map("inbound_qty")
  issueQty     Int @default(0) @map("issue_qty")
  totalQty     Int @default(0) @map("total_qty")

  rawJson   Json     @map("raw_json") // Full Amazon payload for modal drilldown
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("inventory")
}


// Inventory levels by marketplace (FBA breakdown)
model InventoryByMarketplace {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  productId     String   @map("product_id")
  marketplaceId String   @map("marketplace_id")

  fulfillableQty   Int @default(0) @map("fulfillable_qty")
  inboundQty       Int @default(0) @map("inbound_qty")
  reservedQty      Int @default(0) @map("reserved_qty")
  researchingQty   Int @default(0) @map("researching_qty")
  unfulfillableQty Int @default(0) @map("unfulfillable_qty")

  currentQty Int @default(0) @map("current_qty")

  rawJson Json? @map("raw_json")

  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, marketplaceId])
  @@index([userId])
  @@map("inventory_by_marketplace")
}


model Purchase {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  productId          String   @map("product_id")
  fulfilment         String   @default("Amazon")
  supplier           String?
  purchaseDate       DateTime @map("purchase_date")
  orderNumber        String?  @map("order_number")
  shipmentId         String?  @map("shipment_id")
  qtyPurchased       Int      @default(0) @map("qty_purchased")
  qtyDelivered       Int      @default(0) @map("qty_delivered")
  currency           String   @default("GBP")
  vatRatePct         Decimal  @default(0) @map("vat_rate_pct") @db.Decimal(7, 4)
  unitCostIncVat     Decimal  @default(0) @map("unit_cost_inc_vat") @db.Decimal(14, 2)
  deliveryCostIncVat Decimal  @default(0) @map("delivery_cost_inc_vat") @db.Decimal(14, 2)
  prepCostIncVat     Decimal  @default(0) @map("prep_cost_inc_vat") @db.Decimal(14, 2)
  totalCostIncVat    Decimal  @default(0) @map("total_cost_inc_vat") @db.Decimal(14, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  supplierLink       String?  @map("supplier_link")
  bundleSize         Int      @default(1) @map("bundle_size")
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, purchaseDate])
  @@index([productId])
  @@index([shipmentId])
  @@map("purchases")
}

model AggDailyKpiSummary {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  marketplace          String
  fulfilmentChannel    String   @map("fulfilment_channel")
  date                 DateTime @map("date")
  revenue              Decimal  @db.Decimal(14, 2)
  unitsSold            Int
  ordersCount          Int      @map("orders_count")
  amazonFeesTotal      Decimal  @map("amazon_fees_total") @db.Decimal(14, 2)
  refundsTotal         Decimal  @map("refunds_total") @db.Decimal(14, 2)
  cogsTotal            Decimal  @map("cogs_total") @db.Decimal(14, 2)
  prepFeesTotal        Decimal  @map("prep_fees_total") @db.Decimal(14, 2)
  shippingCostsTotal   Decimal  @map("shipping_costs_total") @db.Decimal(14, 2)
  advertisingTotal     Decimal  @map("advertising_total") @db.Decimal(14, 2)
  vatOnAmazonFeesTotal Decimal  @map("vat_on_amazon_fees_total") @db.Decimal(14, 2)
  vatEstimateTotal     Decimal  @map("vat_estimate_total") @db.Decimal(14, 2)
  softwareSubsTotal    Decimal  @map("software_subs_total") @db.Decimal(14, 2)
  otherSubsTotal       Decimal  @map("other_subs_total") @db.Decimal(14, 2)
  vatTotal             Decimal  @map("vat_total") @db.Decimal(14, 2)
  otherCostsTotal      Decimal  @map("other_costs_total") @db.Decimal(14, 2)
  profit               Decimal  @db.Decimal(14, 2)
  roiPct               Decimal  @map("roi_pct") @db.Decimal(7, 4)
  marginPct            Decimal  @map("margin_pct") @db.Decimal(7, 4)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([userId, marketplace, fulfilmentChannel, date])
  @@index([userId])
  @@map("agg_daily_kpi_summary")
}
