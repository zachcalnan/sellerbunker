generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                   @id @default(uuid())
  email          String                   @unique
  passwordHash   String                   @map("password_hash")
  name           String?
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  clerkId        String?                  @unique
  activeOrgId    String?                  @map("active_org_id")
  /// Referral code from ?ref= (audit trail; normalized lowercase)
  referredBy              String?                  @map("referred_by")
  referredAffiliateId     String?                  @map("referred_affiliate_id")
  referredAffiliate       Affiliate?               @relation("UserReferredByAffiliate", fields: [referredAffiliateId], references: [id], onDelete: SetNull)
  affiliateCommissions    AffiliateCommission[]
  inventoryByMarketplace InventoryByMarketplace[]
  inventory      Inventory[]
  orderItems     OrderItem[]
  orders         Order[]
  orgMemberships OrganizationMembership[]
  products       Product[]
  purchases      Purchase[]
  sellerAccounts SellerAccount[]
  shipments      Shipment[]
  subscriptions  Subscription[]
  marketplaceSettings UserMarketplaceSetting[]
  initialSyncProgress InitialSyncProgress?
  activeOrg      Organization?            @relation("ActiveOrg", fields: [activeOrgId], references: [id])

  @@map("users")
}

model Affiliate {
  id               String                  @id @default(uuid())
  referralCode     String                  @unique @map("referral_code")
  name             String?
  email            String?
  /// e.g. 0.15 = 15% of qualifying payment
  commissionRate   Decimal                 @default(0.15) @map("commission_rate") @db.Decimal(7, 4)
  active           Boolean                 @default(true)
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  commissions      AffiliateCommission[]
  referredUsers    User[]                  @relation("UserReferredByAffiliate")

  @@map("affiliates")
}

enum AffiliateCommissionStatus {
  pending
  paid
}

model AffiliateCommission {
  id              String                    @id @default(uuid())
  userId          String                    @map("user_id")
  affiliateId     String                    @map("affiliate_id")
  amount          Decimal                   @db.Decimal(14, 2)
  currency        String                    @default("gbp")
  status          AffiliateCommissionStatus @default(pending)
  stripeEventId   String                    @unique @map("stripe_event_id")
  stripeInvoiceId String?                   @map("stripe_invoice_id")
  /// 1 = first qualifying paid invoice for this referred user, etc.
  paymentNumber   Int                       @default(1) @map("payment_number")
  createdAt       DateTime                  @default(now()) @map("created_at")
  paidAt          DateTime?                 @map("paid_at")
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliate       Affiliate                 @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([affiliateId])
  @@index([userId])
  @@index([status])
  @@map("affiliate_commissions")
}

enum MarketplaceRegion {
  NA
  EU
  AUSTRALASIA
}

enum MarketplaceActivityClass {
  HIGH
  MEDIUM
  INACTIVE
}

model UserMarketplaceSetting {
  id               String                   @id @default(uuid())
  userId           String                   @map("user_id")
  marketplaceId    String                   @map("marketplace_id")
  countryCode      String                   @map("country_code")
  region           MarketplaceRegion
  currencyCode     String                   @map("currency_code")
  isBase           Boolean                  @default(false) @map("is_base")
  isEnabledByUser  Boolean                  @default(false) @map("is_enabled_by_user")
  detectedBySystem Boolean                  @default(false) @map("detected_by_system")
  activityClass    MarketplaceActivityClass @default(INACTIVE) @map("activity_class")
  orderCount24h    Int                      @default(0) @map("order_count_24h")
  lastActivityCheckAt DateTime?             @map("last_activity_check_at")
  nextSyncAt       DateTime?                @map("next_sync_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketplaceId])
  @@index([userId, region])
  @@index([userId, isEnabledByUser])
  @@map("user_marketplace_settings")
}

// Single source of truth for "syncing" bar: survives Redis flush and job removal. Worker + enqueue write; API reads.
model InitialSyncProgress {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  progress  Int      // 0-100
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("initial_sync_progress")
}

model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  stripeCustomerId     String?   @map("stripe_customer_id")
  status               String    @default("active") // active | trialing | canceled | past_due etc.
  trialEndAt           DateTime? @map("trial_end_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("subscriptions")
}

model Organization {
  id                     String                   @id @default(uuid())
  name                   String
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  lastFbaInventorySyncAt DateTime?
  lastFeesEstimateAt     DateTime?                @map("last_fees_estimate_at")
  /// Set when the repricer engine finishes a pass for this org (including no-op price decisions).
  repricerLastEngineAt   DateTime?                @map("repricer_last_engine_at")
  // VAT: NON_VAT_REGISTERED | VAT_STANDARD | VAT_FLAT_RATE
  vatRegistrationType    String?                  @map("vat_registration_type")
  vatEffectiveDate       DateTime?                @map("vat_effective_date") // when to start applying VAT logic
  vatFlatRatePct         Decimal?                 @map("vat_flat_rate_pct") @db.Decimal(7, 4) // flat rate %
  vatRatePct             Decimal?                @map("vat_rate_pct") @db.Decimal(7, 4) // standard rate % for costs/revenue
  vatCostsIncludeVat     Boolean?                 @map("vat_costs_include_vat") // true = user enters costs incl VAT
  fixedCostsSoftware     Decimal?                 @map("fixed_costs_software") @db.Decimal(14, 2)
  fixedCostsOtherSubs    Decimal?                 @map("fixed_costs_other_subs") @db.Decimal(14, 2)
  fixedCostsOther        Decimal?                @map("fixed_costs_other") @db.Decimal(14, 2)
  /// Optional per-line breakdown for fixed costs (stored monthly).
  fixedCostsSoftwareItems Json?                  @map("fixed_costs_software_items")
  fixedCostsOtherSubsItems Json?                 @map("fixed_costs_other_subs_items")
  fixedCostsOtherItems   Json?                   @map("fixed_costs_other_items")
  members                OrganizationMembership[]
  usersWithActiveOrg     User[]                   @relation("ActiveOrg")

  @@map("organizations")
}

model OrganizationMembership {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  userId    String       @map("user_id")
  role      String       @default("member")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId])
  @@map("organization_memberships")
}

model SellerAccount {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  marketplace        String
  sellerId           String?   @map("seller_id")
  credentials        Json
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  ordersLastSyncedAt DateTime? @map("orders_last_synced_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketplace])
  @@index([userId])
  @@map("seller_accounts")
}

model Product {
  id                         String      @id @default(uuid())
  userId                     String      @map("user_id")
  sku                        String
  asin                       String?
  title                      String?
  imageUrl                   String?     @map("image_url")
  productType                String?     @map("product_type")
  displayGroup               String?     @map("display_group")
  costOfGoods                Decimal?    @map("cost_of_goods") @db.Decimal(10, 2)
  estimatedAmazonFeePerUnit  Decimal?    @map("estimated_amazon_fee_per_unit") @db.Decimal(10, 2)
  estimatedReferralFeePerUnit Decimal?   @map("estimated_referral_fee_per_unit") @db.Decimal(10, 2)
  estimatedFbaFeePerUnit     Decimal?    @map("estimated_fba_fee_per_unit") @db.Decimal(10, 2)
  estimatedDigitalServiceFeePerUnit Decimal? @map("estimated_digital_service_fee_per_unit") @db.Decimal(10, 2)
  estimatedAmazonFeeUpdatedAt DateTime?  @map("estimated_amazon_fee_updated_at")
  currentListedPrice         Decimal?    @map("current_listed_price") @db.Decimal(10, 2)
  currentListedPriceUpdatedAt DateTime?  @map("current_listed_price_updated_at")
  feeEstimateRawJson         Json?       @map("fee_estimate_raw_json")
  createdAt                  DateTime    @default(now()) @map("created_at")
  updatedAt                  DateTime    @updatedAt @map("updated_at")
  inventory   Inventory?
  inventoryByMarketplace InventoryByMarketplace[]
  orderItems  OrderItem[]
  orders      Order[]
  repricerSelectedSkus RepricerSelectedSku[]
  repricerLogs RepricerLog[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases   Purchase[]

  @@unique([userId, sku])
  @@index([userId])
  @@index([asin])
  @@map("products")
}

model Order {
  id                  String      @id @default(uuid())
  userId              String      @map("user_id")
  productId           String      @map("product_id")
  orderId             String      @map("order_id")
  marketplace         String
  sku                 String
  asin                String?
  quantity            Int         @default(1)
  itemPrice           Decimal     @map("item_price") @db.Decimal(10, 2)
  fees                Json
  totalProfit         Decimal?    @map("total_profit") @db.Decimal(10, 2)
  rawResponse         Json?       @map("raw_response")
  /// SP-API Orders API OrderStatus (e.g. Canceled). Used to exclude non-sales from revenue totals.
  amazonOrderStatus   String?     @map("amazon_order_status")
  orderDate           DateTime    @map("order_date")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  orderItems  OrderItem[]
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, orderId, marketplace])
  @@index([userId])
  @@index([userId, orderDate])
  @@index([productId])
  @@map("orders")
}

model OrderItem {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  orderDbId            String   @map("order_db_id")
  productId            String   @map("product_id")
  marketplace          String
  orderId              String   @map("order_id")
  orderItemId          String   @map("order_item_id")
  sku                  String
  asin                 String?
  quantity             Int      @default(1)
  revenueTotal         Decimal  @map("revenue_total") @db.Decimal(14, 2)
  shippingChargedTotal Decimal  @map("shipping_charged_total") @db.Decimal(14, 2)
  taxChargedTotal      Decimal  @map("tax_charged_total") @db.Decimal(14, 2)
  amazonFeesTotal      Decimal  @map("amazon_fees_total") @db.Decimal(14, 2)
  feesSource           String?  @map("fees_source") // 'finances' = settled from Finances API (exact); 'estimate' = from product estimate
  settledReferralFeeTotal    Decimal? @map("settled_referral_fee_total") @db.Decimal(14, 2)
  settledFbaFeeTotal         Decimal? @map("settled_fba_fee_total") @db.Decimal(14, 2)
  settledDigitalServiceFeeTotal Decimal? @map("settled_digital_service_fee_total") @db.Decimal(14, 2)
  cogsTotal            Decimal? @map("cogs_total") @db.Decimal(14, 2)
  profit               Decimal? @map("profit") @db.Decimal(14, 2)
  rawResponse          Json?    @map("raw_response")
  orderDate            DateTime @map("order_date")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  // VAT breakdown (nullable for backfill): revenue and costs inc/excl VAT for profit ex VAT and VAT balance
  salePriceIncVat      Decimal? @map("sale_price_inc_vat") @db.Decimal(14, 2)
  salePriceExVat       Decimal? @map("sale_price_ex_vat") @db.Decimal(14, 2)
  saleVatAmount        Decimal? @map("sale_vat_amount") @db.Decimal(14, 2)
  estimatedSalePriceIncVat Decimal? @map("estimated_sale_price_inc_vat") @db.Decimal(14, 2)
  estimatedSalePriceExVat  Decimal? @map("estimated_sale_price_ex_vat") @db.Decimal(14, 2)
  estimatedSaleVatAmount   Decimal? @map("estimated_sale_vat_amount") @db.Decimal(14, 2)
  unitCostIncVat       Decimal? @map("unit_cost_inc_vat") @db.Decimal(14, 2)
  unitCostExVat        Decimal? @map("unit_cost_ex_vat") @db.Decimal(14, 2)
  unitVatAmount        Decimal? @map("unit_vat_amount") @db.Decimal(14, 2)
  deliveryIncVat       Decimal? @map("delivery_inc_vat") @db.Decimal(14, 2)
  deliveryExVat        Decimal? @map("delivery_ex_vat") @db.Decimal(14, 2)
  deliveryVatAmount    Decimal? @map("delivery_vat_amount") @db.Decimal(14, 2)
  prepIncVat           Decimal? @map("prep_inc_vat") @db.Decimal(14, 2)
  prepExVat            Decimal? @map("prep_ex_vat") @db.Decimal(14, 2)
  prepVatAmount        Decimal? @map("prep_vat_amount") @db.Decimal(14, 2)
  // Fee VAT (always computed for later VAT balance): Amazon fees ex/incl VAT
  amazonFeesExVat      Decimal? @map("amazon_fees_ex_vat") @db.Decimal(14, 2)
  amazonFeesIncVat     Decimal? @map("amazon_fees_inc_vat") @db.Decimal(14, 2)
  amazonFeesVatAmount  Decimal? @map("amazon_fees_vat_amount") @db.Decimal(14, 2)
  order                Order    @relation(fields: [orderDbId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderDbId, orderItemId])
  @@index([userId])
  @@index([userId, orderDate])
  @@index([productId])
  @@map("order_items")
}

model Inventory {
  productId String @id @map("product_id")
  userId    String @map("user_id")

  // Summary buckets (table view)
  availableQty Int @default(0) @map("available_qty") // = fulfillable
  reservedQty  Int @default(0) @map("reserved_qty")
  inboundQty   Int @default(0) @map("inbound_qty")
  issueQty     Int @default(0) @map("issue_qty")
  totalQty     Int @default(0) @map("total_qty")

  rawJson   Json     @map("raw_json") // Full Amazon payload for modal drilldown
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("inventory")
}


// Inventory levels by marketplace (FBA breakdown)
model InventoryByMarketplace {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  productId     String   @map("product_id")
  marketplaceId String   @map("marketplace_id")

  fulfillableQty   Int @default(0) @map("fulfillable_qty")
  inboundQty       Int @default(0) @map("inbound_qty")
  reservedQty      Int @default(0) @map("reserved_qty")
  researchingQty   Int @default(0) @map("researching_qty")
  unfulfillableQty Int @default(0) @map("unfulfillable_qty")

  // Granular breakdown from FBA API (details=true)
  fcProcessingQty      Int @default(0) @map("fc_processing_qty")
  customerOrdersQty    Int @default(0) @map("customer_orders_qty")
  transshipmentQty    Int @default(0) @map("transshipment_qty")
  inboundWorkingQty   Int @default(0) @map("inbound_working_qty")
  inboundShippedQty   Int @default(0) @map("inbound_shipped_qty")
  inboundReceivingQty Int @default(0) @map("inbound_receiving_qty")
  warehouseDamagedQty  Int @default(0) @map("warehouse_damaged_qty")
  expiredQty          Int @default(0) @map("expired_qty")

  currentQty Int @default(0) @map("current_qty")

  rawJson Json? @map("raw_json")

  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, marketplaceId])
  @@index([userId])
  @@map("inventory_by_marketplace")
}


model Shipment {
  id                                String    @id @default(uuid())
  userId                            String    @map("user_id")
  shipmentId                        String    @map("shipment_id")
  shipmentName                      String?   @map("shipment_name")
  shipmentStatus                    String?   @map("shipment_status")
  destinationFulfillmentCenterId    String?   @map("destination_fulfillment_center_id")
  createdDate                       DateTime? @map("created_date")
  lastUpdatedDate                   DateTime? @map("last_updated_date")
  unitsSent                         Int       @default(0) @map("units_sent")
  unitsReceived                     Int       @default(0) @map("units_received")
  unitsDamaged                      Int       @default(0) @map("units_damaged")
  unitsDisposed                     Int       @default(0) @map("units_disposed")
  unitsMissing                      Int       @default(0) @map("units_missing")
  pickupDate                        DateTime? @map("pickup_date")
  transportStatus                   String?   @map("transport_status")
  deliveryDate                      DateTime? @map("delivery_date")
  damageClosedDate                  DateTime? @map("damage_closed_date")
  checkInDurationDays               Int?      @map("check_in_duration_days")
  checkedInDate                     DateTime? @map("checked_in_date")
  checkedInDateIsClosedDate         Boolean?  @map("checked_in_date_is_closed_date")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")
  user                              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shipmentId])
  @@index([userId])
  @@map("shipments")
}

model Purchase {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  productId          String   @map("product_id")
  fulfilment         String   @default("Amazon")
  supplier           String?
  purchaseDate       DateTime @map("purchase_date")
  orderNumber        String?  @map("order_number")
  shipmentId         String?  @map("shipment_id")
  qtyPurchased       Int      @default(0) @map("qty_purchased")
  qtyDelivered       Int      @default(0) @map("qty_delivered")
  currency           String   @default("GBP")
  vatRatePct         Decimal  @default(0) @map("vat_rate_pct") @db.Decimal(7, 4)
  // true = user entered costs incl VAT; false = excl VAT (only one stored, other derived)
  costsEnteredInclVat Boolean  @default(true) @map("costs_entered_incl_vat")
  unitCostIncVat     Decimal  @default(0) @map("unit_cost_inc_vat") @db.Decimal(14, 2)
  unitCostExVat      Decimal? @map("unit_cost_ex_vat") @db.Decimal(14, 2)
  deliveryCostIncVat Decimal  @default(0) @map("delivery_cost_inc_vat") @db.Decimal(14, 2)
  deliveryCostExVat  Decimal? @map("delivery_cost_ex_vat") @db.Decimal(14, 2)
  prepCostIncVat     Decimal  @default(0) @map("prep_cost_inc_vat") @db.Decimal(14, 2)
  prepCostExVat      Decimal? @map("prep_cost_ex_vat") @db.Decimal(14, 2)
  totalCostIncVat    Decimal  @default(0) @map("total_cost_inc_vat") @db.Decimal(14, 2)
  totalCostExVat     Decimal? @map("total_cost_ex_vat") @db.Decimal(14, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  supplierLink       String?  @map("supplier_link")
  bundleSize         Int      @default(1) @map("bundle_size")
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, purchaseDate])
  @@index([productId])
  @@index([shipmentId])
  @@map("purchases")
}

model AggDailyKpiSummary {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  marketplace          String
  fulfilmentChannel    String   @map("fulfilment_channel")
  date                 DateTime @map("date")
  revenue              Decimal  @db.Decimal(14, 2)
  unitsSold            Int
  ordersCount          Int      @map("orders_count")
  amazonFeesTotal      Decimal  @map("amazon_fees_total") @db.Decimal(14, 2)
  refundsTotal         Decimal  @map("refunds_total") @db.Decimal(14, 2)
  cogsTotal            Decimal  @map("cogs_total") @db.Decimal(14, 2)
  prepFeesTotal        Decimal  @map("prep_fees_total") @db.Decimal(14, 2)
  shippingCostsTotal   Decimal  @map("shipping_costs_total") @db.Decimal(14, 2)
  advertisingTotal     Decimal  @map("advertising_total") @db.Decimal(14, 2)
  vatOnAmazonFeesTotal Decimal  @map("vat_on_amazon_fees_total") @db.Decimal(14, 2)
  vatEstimateTotal     Decimal  @map("vat_estimate_total") @db.Decimal(14, 2)
  softwareSubsTotal    Decimal  @map("software_subs_total") @db.Decimal(14, 2)
  otherSubsTotal       Decimal  @map("other_subs_total") @db.Decimal(14, 2)
  vatTotal             Decimal  @map("vat_total") @db.Decimal(14, 2)
  otherCostsTotal      Decimal  @map("other_costs_total") @db.Decimal(14, 2)
  profit               Decimal  @db.Decimal(14, 2)
  roiPct               Decimal  @map("roi_pct") @db.Decimal(7, 4)
  marginPct            Decimal  @map("margin_pct") @db.Decimal(7, 4)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([userId, marketplace, fulfilmentChannel, date])
  @@index([userId])
  @@map("agg_daily_kpi_summary")
}

model RepricerSelectedSku {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  productId String   @map("product_id")
  /// Which saved pricing preset applies to this SKU (repricer engine uses this rule set).
  ruleSetId String?  @map("rule_set_id")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  ruleSet   RepricerRuleSet? @relation(fields: [ruleSetId], references: [id], onDelete: SetNull)

  @@unique([orgId, productId])
  @@index([orgId])
  @@index([productId])
  @@index([ruleSetId])
  @@map("repricer_selected_skus")
}

model RepricerRuleSet {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String   @default("Default")
  isActive  Boolean  @default(true) @map("is_active")

  // Rule 1
  rule1Label    String? @map("rule1_label")
  /// buy_box: buy box price from competitive pricing; best_offer: lowest listing/landed among CompetitivePrices
  rule1PriceReference String @default("buy_box") @map("rule1_price_reference")
  rule1MinProfit Decimal?  @map("rule1_min_profit") @db.Decimal(14, 2)
  rule1MaxProfit Decimal?  @map("rule1_max_profit") @db.Decimal(14, 2)
  /// Listing currency: hard floor (optional). Tightened with profit/ROI bounds — highest floor wins.
  rule1MinListPrice Decimal? @map("rule1_min_list_price") @db.Decimal(14, 2)
  /// Listing currency: hard ceiling (optional). Tightened with profit/ROI bounds — lowest ceiling wins.
  rule1MaxListPrice Decimal? @map("rule1_max_list_price") @db.Decimal(14, 2)
  rule1MinRoiPct Decimal?  @map("rule1_min_roi_pct") @db.Decimal(7, 4)
  rule1MaxRoiPct Decimal?  @map("rule1_max_roi_pct") @db.Decimal(7, 4)
  rule1EndsAt    DateTime? @map("rule1_ends_at")
  rule1Strategy  String?   @map("rule1_strategy") // match_buy_box | beat_buy_box | stay_above_buy_box
  rule1BeatType  String?   @map("rule1_beat_type") // amount | percent
  rule1BeatValue Decimal?  @map("rule1_beat_value") @db.Decimal(14, 4)
  rule1OnlyWhenBuyBoxFba Boolean @default(false) @map("rule1_only_when_buy_box_fba")
  rule1IgnoreAmazon Boolean @default(true) @map("rule1_ignore_amazon")
  rule1IgnoreFbm Boolean @default(false) @map("rule1_ignore_fbm")
  rule1IgnoreSellerViewsEnabled Boolean @default(false) @map("rule1_ignore_seller_views_enabled")
  rule1IgnoreSellerViewsBelow Int? @map("rule1_ignore_seller_views_below")
  rule1IgnoreSellerIds Json? @map("rule1_ignore_seller_ids")
  rule1MinSellerFeedbackPct Decimal? @map("rule1_min_seller_feedback_pct") @db.Decimal(7, 4)
  rule1CooldownMinutes Int? @map("rule1_cooldown_minutes")
  rule1SmartDelayEnabled Boolean @default(true) @map("rule1_smart_delay_enabled")

  // Rule 2
  rule2Label    String? @map("rule2_label")
  rule2PriceReference String @default("buy_box") @map("rule2_price_reference")
  rule2MinProfit Decimal?  @map("rule2_min_profit") @db.Decimal(14, 2)
  rule2MaxProfit Decimal?  @map("rule2_max_profit") @db.Decimal(14, 2)
  rule2MinListPrice Decimal? @map("rule2_min_list_price") @db.Decimal(14, 2)
  rule2MaxListPrice Decimal? @map("rule2_max_list_price") @db.Decimal(14, 2)
  rule2MinRoiPct Decimal?  @map("rule2_min_roi_pct") @db.Decimal(7, 4)
  rule2MaxRoiPct Decimal?  @map("rule2_max_roi_pct") @db.Decimal(7, 4)
  rule2EndsAt    DateTime? @map("rule2_ends_at")
  rule2Strategy  String?   @map("rule2_strategy") // match_buy_box | beat_buy_box | stay_above_buy_box
  rule2BeatType  String?   @map("rule2_beat_type") // amount | percent
  rule2BeatValue Decimal?  @map("rule2_beat_value") @db.Decimal(14, 4)
  rule2OnlyWhenBuyBoxFba Boolean @default(false) @map("rule2_only_when_buy_box_fba")
  rule2IgnoreAmazon Boolean @default(true) @map("rule2_ignore_amazon")
  rule2IgnoreFbm Boolean @default(false) @map("rule2_ignore_fbm")
  rule2IgnoreSellerViewsEnabled Boolean @default(false) @map("rule2_ignore_seller_views_enabled")
  rule2IgnoreSellerViewsBelow Int? @map("rule2_ignore_seller_views_below")
  rule2IgnoreSellerIds Json? @map("rule2_ignore_seller_ids")
  rule2MinSellerFeedbackPct Decimal? @map("rule2_min_seller_feedback_pct") @db.Decimal(7, 4)
  rule2CooldownMinutes Int? @map("rule2_cooldown_minutes")
  rule2SmartDelayEnabled Boolean @default(true) @map("rule2_smart_delay_enabled")

  /// After this many days from rule start, switch to followUpRuleSet (optional).
  chainAfterDays Int? @map("chain_after_days")
  followUpRuleSetId String? @map("follow_up_rule_set_id")
  followUpRuleSet RepricerRuleSet? @relation("RepricerRuleChain", fields: [followUpRuleSetId], references: [id], onDelete: SetNull)
  chainedFrom RepricerRuleSet[] @relation("RepricerRuleChain")
  assignedSkus RepricerSelectedSku[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orgId])
  @@index([followUpRuleSetId])
  @@map("repricer_rule_sets")
}

model RepricerLog {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  productId String   @map("product_id")
  sku       String
  kind      String   @default("decision") // decision | applied | error
  message   String
  prevPrice Decimal? @map("prev_price") @db.Decimal(10, 2)
  nextPrice Decimal? @map("next_price") @db.Decimal(10, 2)
  context   Json?    @map("context")
  createdAt DateTime @default(now()) @map("created_at")
  /// Bumped when the same SKU logs "listing unchanged" again (one anchored row per product).
  lastCheckedAt DateTime? @map("last_checked_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([productId])
  @@index([orgId, createdAt])
  @@index([orgId, productId])
  @@map("repricer_logs")
}
